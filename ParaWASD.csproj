<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ParaWASD</AssemblyName>
    <Description>WASD movement and first-person camera mod for Paralives</Description>
  </PropertyGroup>

  <PropertyGroup>
    <BepInExRoot Condition="'$(BepInExRoot)' == ''">..\..\BepInEx</BepInExRoot>
    <BepInExCorePath>$(BepInExRoot)\core</BepInExCorePath>
    <BepInExTarget Condition="'$(BepInExTarget)' == '' And Exists('$(BepInExCorePath)\BepInEx.Unity.Mono.dll')">6UnityMono</BepInExTarget>
    <BepInExTarget Condition="'$(BepInExTarget)' == '' And Exists('$(BepInExCorePath)\BepInEx.Unity.dll')">6Unity</BepInExTarget>
    <BepInExTarget Condition="'$(BepInExTarget)' == ''">5</BepInExTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BepInExTarget)' == '6UnityMono'">
    <DefineConstants>$(DefineConstants);BEPINEX_UNITY_MONO</DefineConstants>
  </PropertyGroup>

  <!-- Game assemblies (do not copy to output - they exist at runtime) -->
  <ItemGroup>
    <Reference Include="Paralives">
      <HintPath>..\..\Paralives_Data\Managed\Paralives.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\Paralives_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\Paralives_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\Paralives_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>..\..\Paralives_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputModule">
      <HintPath>..\..\Paralives_Data\Managed\UnityEngine.InputModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\..\Paralives_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\..\Paralives_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>..\..\Paralives_Data\Managed\UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>..\..\Paralives_Data\Managed\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>..\..\Paralives_Data\Managed\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\..\Paralives_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>..\..\Paralives_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- BepInEx + Harmony -->
    <Reference Include="BepInEx.Core" Condition="'$(BepInExTarget)' == '6UnityMono' Or '$(BepInExTarget)' == '6Unity'">
      <HintPath>$(BepInExCorePath)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.Mono" Condition="'$(BepInExTarget)' == '6UnityMono'">
      <HintPath>$(BepInExCorePath)\BepInEx.Unity.Mono.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity" Condition="'$(BepInExTarget)' == '6Unity'">
      <HintPath>$(BepInExCorePath)\BepInEx.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx" Condition="'$(BepInExTarget)' == '5'">
      <HintPath>$(BepInExCorePath)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCorePath)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
